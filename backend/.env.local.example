# Backend local environment (example)
# Copy to `backend/.env.local` and fill values.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

PORT=3004
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

JWT_ACCESS_SECRET="dev_only_change_me"
JWT_ACCESS_TTL_SECONDS=900

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

SUPABASE_AVATARS_BUCKET="test"
SUPABASE_ACTIVITY_MEDIA_BUCKET="activity-media"
SUPABASE_GPX_BUCKET="gpx"
SUPABASE_IMPORT_GPX_FUNCTION="import-gpx"
SUPABASE_HTTP_TIMEOUT_MS=60000

# 42 Intra OAuth
FRONTEND_URL="http://localhost:5173"
INTRA_CLIENT_ID="u-..."
INTRA_CLIENT_SECRET="s-..."
INTRA_REDIRECT_URI="http://localhost:3004/api/auth/intra/callback"
INTRA_STATE_SECRET="change_me"

# Public API (shared key for integrations)
PUBLIC_API_KEY="change_me_long_random"
# Rate limit per API key + IP
PUBLIC_API_RATELIMIT_MAX=60
PUBLIC_API_RATELIMIT_WINDOW_MS=60000
