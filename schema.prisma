generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuthProvider {
  email
  google
  intra
}

//String? → nullable (user may not have email)
//@map() is used to rename the field in the database, while keeping a different name in your Prisma code
//@default(now()) When inserting a new record, automatically set this field to the current time.
//@updatedAt  Every time this record is updated, automatically set this field to the current time.
//@@map("users") rename is database
// @id
//This is the primary key of the table
//Every row must have a unique value here — no duplicates allowed
//It cannot be null — every row must have a value
model User {
  id              BigInt    @id @default(autoincrement())
  email           String?   @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  password   UserPassword?
  profile    Profile?
  identities UserIdentity[]
  sessions   Session[]
  resets     PasswordResetToken[]

  @@map("users")
}

model UserPassword {
  userId       BigInt   @id @map("user_id")
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // the first name is the relation name to use in the code and the 2nd User is the model i am linking to 

  @@map("user_passwords")
}

model UserIdentity {
  id          BigInt       @id @default(autoincrement())
  userId      BigInt       @map("user_id")
  provider    AuthProvider
  providerUid String       @map("provider_uid") @db.VarChar(255)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid]) // this means a provider can not have the same uid twice
  @@unique([userId, provider]) // a user can not have the same provider 
  @@map("user_identities")
}

model EmailVerificationCode {
  id         BigInt    @id @default(autoincrement())
  email      String    @db.VarChar(255)
  code       String    @db.VarChar(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("email_verification_codes")
}

model Profile {
  userId BigInt @id @map("user_id")

  firstName   String?   @map("first_name") @db.VarChar(100)
  lastName    String?   @map("last_name") @db.VarChar(100)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?   @db.VarChar(20)
  level       String?   @db.VarChar(50)
  weightKg    Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  heightCm    Decimal?  @map("height_cm") @db.Decimal(5, 2)

  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
