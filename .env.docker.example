# Copy to .env and fill in values

# Supabase (hosted)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
SUPABASE_JWT_SECRET=

# Local Postgres (defaults are fine)
POSTGRES_USER=pace42
POSTGRES_PASSWORD=pace42
POSTGRES_DB=pace42

# Backend
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_BACKEND_URL=http://localhost:3004

# Frontend Supabase (optional; leave blank to reuse SUPABASE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
