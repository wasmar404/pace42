# Copy to .env and fill in your values (do not commit .env)

# Backend
PORT=3004
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase (hosted)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (hosted Supabase Postgres)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional (only if you validate HS256 locally)
SUPABASE_JWT_SECRET=

# Optional SMTP / OAuth
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Buckets / edge function
SUPABASE_AVATARS_BUCKET=test
SUPABASE_ACTIVITY_MEDIA_BUCKET=activity-media
SUPABASE_GPX_BUCKET=gpx
SUPABASE_IMPORT_GPX_FUNCTION=import-gpx

# Public API
PUBLIC_API_KEY=dev_public_api_key_change_me

# Frontend
VITE_BACKEND_URL=http://localhost:3004
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
