# Copy to .env and fill in your values (do not commit .env)

# Backend
PORT=3004
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Supabase local uses 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (local Kong)
SUPABASE_PUBLIC_URL=http://localhost:54321
SUPABASE_URL=http://localhost:54321

# Supabase auth settings
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://127.0.0.1:5173
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true

# Secrets / keys (set these)
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional SMTP / OAuth
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Buckets / edge function
SUPABASE_AVATARS_BUCKET=test
SUPABASE_ACTIVITY_MEDIA_BUCKET=activity-media
SUPABASE_GPX_BUCKET=gpx
SUPABASE_IMPORT_GPX_FUNCTION=import-gpx

# Public API
PUBLIC_API_KEY=dev_public_api_key_change_me

# Frontend
VITE_BACKEND_URL=http://localhost:3004
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=
