
## DB (Supabase)
# Prisma + Supabase Pooler:
# - Use pgbouncer=true (Prisma compatibility)
# - Keep connection_limit=1 to avoid pool exhaustion
# - If :6543 is reachable for you, use it. Otherwise :5432 is usually reachable.
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=0"
DIRECT_URL="postgresql://<user>:<password>@<pooler-host>:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=0"

# Supabase (backend)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_ACTIVITY_MEDIA_BUCKET="activity-media"
SUPABASE_GPX_BUCKET="gpx"
SUPABASE_IMPORT_GPX_FUNCTION="import-gpx"
SUPABASE_HTTP_TIMEOUT_MS=60000

# Backend
PORT=3004
CORS_ORIGIN=http://localhost:5173
PUBLIC_API_KEY=dev_public_api_key

# Frontend
VITE_BACKEND_URL=http://localhost:3004
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
